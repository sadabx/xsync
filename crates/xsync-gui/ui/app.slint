import { ScrollView, LineEdit } from "std-widgets.slint";

export struct WatchedDir {
    local_path: string,
    drive_folder_id: string,
    drive_folder_name: string,
}

export struct RecentFile {
    rel_path: string,
    size_str: string,
    time_str: string,
}

export struct DiffItem {
    path: string,
    side: string,
}

// Compact Google Material Sidebar Navigation Pill with Vector SVG Icon
component NavPill {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> is_dark: false;
    callback clicked();

    Rectangle {
        height: 38px;
        background: root.active ? 
            (root.is_dark ? #004a77 : #c2e7ff) : 
            (touch.has-hover ? (root.is_dark ? #28292a : #e8effa) : transparent);
        border-radius: 19px;
        animate background { duration: 100ms; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                vertical-alignment: center;
                colorize: root.active ? 
                    (root.is_dark ? #c2e7ff : #001d35) : 
                    (root.is_dark ? #e3e3e3 : #444746);
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                alignment: center;

                Text {
                    text: root.title;
                    color: root.active ? 
                        (root.is_dark ? #c2e7ff : #001d35) : 
                        (root.is_dark ? #e3e3e3 : #1f1f1f);
                    font-size: 12px;
                    font-weight: root.active ? 700 : 500;
                    overflow: elide;
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: root.active ? 
                        (root.is_dark ? #7fcfff : #004a77) : 
                        (root.is_dark ? #9aa0a6 : #5f6368);
                    font-size: 10px;
                    overflow: elide;
                }
            }
        }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// Compact Button with optional vector icon
component CompactButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> is_dark: false;
    in property <image> icon;
    in property <bool> has_icon: false;
    callback clicked();

    Rectangle {
        height: 28px;
        background: root.primary ? 
            (root.is_dark ? (touch.has-hover ? #a8c7fa : #8ab4f8) : (touch.has-hover ? #0842a0 : #0b57d0)) :
            (root.destructive ? (touch.has-hover ? #b91c1c : #dc2626) :
            (root.is_dark ? (touch.has-hover ? #3c4043 : #282a2c) : (touch.has-hover ? #d8dfea : #f1f3f4)));

        border-radius: 14px;
        border-width: (root.primary || root.destructive) ? 0px : 1px;
        border-color: root.is_dark ? #4a4d51 : #dadce0;
        animate background { duration: 100ms; }

        HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 6px;
            alignment: center;

            if root.has_icon: Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                vertical-alignment: center;
                colorize: root.primary ? 
                    (root.is_dark ? #001d35 : #ffffff) : 
                    (root.destructive ? #ffffff : (root.is_dark ? #e3e3e3 : #3c4043));
            }

            Text {
                text: root.text;
                color: root.primary ? 
                    (root.is_dark ? #001d35 : #ffffff) : 
                    (root.destructive ? #ffffff : (root.is_dark ? #e3e3e3 : #3c4043));
                font-size: 11.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// Subtle Action Button with optional vector icon
component SubtleButton {
    in property <string> text;
    in property <bool> destructive: false;
    in property <bool> is_dark: false;
    in property <image> icon;
    in property <bool> has_icon: false;
    callback clicked();

    Rectangle {
        height: 24px;
        background: touch.has-hover ? 
            (root.destructive ? (root.is_dark ? #7f1d1d40 : #fee2e2) : (root.is_dark ? #333537 : #e5edf8)) : 
            transparent;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.destructive ? 
            (root.is_dark ? #991b1b : #fca5a5) : 
            (root.is_dark ? #3c4043 : #dadce0);
        animate background { duration: 100ms; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: center;

            if root.has_icon: Image {
                source: root.icon;
                width: 12px;
                height: 12px;
                vertical-alignment: center;
                colorize: root.destructive ? 
                    (root.is_dark ? #fca5a5 : #b91c1c) : 
                    (root.is_dark ? #e3e3e3 : #3c4043);
            }

            Text {
                text: root.text;
                color: root.destructive ? 
                    (root.is_dark ? #fca5a5 : #b91c1c) : 
                    (root.is_dark ? #e3e3e3 : #3c4043);
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// Group Container (Google Preferences Section)
component GroupSection {
    in property <string> title: "";
    in property <string> description: "";
    in property <color> card_bg: #f8fafd;
    in property <color> card_border: #e0e3e7;
    in property <color> title_color: #1f1f1f;
    in property <color> desc_color: #5f6368;

    VerticalLayout {
        alignment: start;
        spacing: 6px;

        if root.title != "": Text {
            text: root.title;
            color: root.title_color;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        if root.description != "": Text {
            text: root.description;
            color: root.desc_color;
            font-size: 11.5px;
        }

        Rectangle {
            background: root.card_bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.card_border;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                @children
            }
        }
    }
}

// List Row with vector SVG Icon
component ListRow {
    in property <string> title;
    in property <string> subtitle: "";
    in property <image> icon;
    in property <color> icon_bg: #e1f0ff;
    in property <color> icon_color: #0b57d0;
    in property <color> text_color: #1f1f1f;
    in property <color> subtitle_color: #5f6368;
    in property <bool> show_divider: false;
    in property <color> divider_color: #e0e3e7;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 12px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: root.icon_bg;
                vertical-stretch: 0;

                Image {
                    source: root.icon;
                    width: 15px;
                    height: 15px;
                    colorize: root.icon_color;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                alignment: center;

                Text {
                    text: root.title;
                    color: root.text_color;
                    font-size: 12.5px;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: root.subtitle_color;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            @children
        }

        if root.show_divider: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Rectangle {
                height: 1px;
                background: root.divider_color;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "xsync - Google Drive Desktop";
    icon: @image-url("logo.png");
    min-width: 820px;
    min-height: 520px;
    preferred-width: 880px;
    preferred-height: 580px;

    // Theme toggle state
    in-out property <bool> is_dark: true;

    // Google Material Design Colors
    property <color> bg_window: root.is_dark ? #18191a : #fcfcfc;
    property <color> bg_sidebar: root.is_dark ? #212224 : #f4f6f9;
    property <color> bg_card: root.is_dark ? #282a2c : #ffffff;
    property <color> border_color: root.is_dark ? #3c4043 : #e2e5e9;
    property <color> text_main: root.is_dark ? #e8eaed : #1a1c1e;
    property <color> text_muted: root.is_dark ? #9aa0a6 : #505459;
    property <color> text_dim: root.is_dark ? #80868b : #72777d;
    property <color> header_bg: root.is_dark ? #212224 : #f4f6f9;

    background: root.bg_window;

    // App state properties
    in-out property <int> active_tab: 0;
    in-out property <bool> is_connected: false;
    in-out property <bool> is_syncing: false;
    in-out property <bool> is_paused: false;
    in-out property <string> user_name: "Google Account";
    in-out property <string> user_email: "Checking connection...";
    in-out property <string> status_message: "All files up to date";
    in-out property <string> storage_used_str: "0 GB";
    in-out property <string> storage_total_str: "15 GB";
    in-out property <float> storage_ratio: 0.0;

    in-out property <int> total_directories: 0;
    in-out property <int> total_files_tracked: 0;
    in-out property <string> total_bytes_str: "0 MB";

    in-out property <[WatchedDir]> directories: [];
    in-out property <[RecentFile]> recent_files: [];
    in-out property <[DiffItem]> diff_items: [];

    in-out property <string> new_folder_local: "";
    in-out property <string> new_folder_remote: "";

    in-out property <string> diff_folder1: "root";
    in-out property <string> diff_folder2: "Backup";
    in-out property <string> diff_summary: "Select folders to compare";

    // Callbacks to Rust
    callback sync_now();
    callback toggle_pause();
    callback add_directory(string, string);
    callback remove_directory(string);
    callback browse_local_folder();
    callback run_diff(string, string);
    callback run_merge(string, string);
    callback systemd_action(string);
    callback refresh_state();
    callback logout();
    callback login();

    // Main window background wrapper
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg_window;

        VerticalLayout {
            spacing: 0px;

            // TOP HEADERBAR (Split matching 210px sidebar + content area)
            Rectangle {
                height: 44px;
                background: root.header_bg;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: root.border_color;
                }

                HorizontalLayout {
                    spacing: 0px;

                    // Left Column (width 210px matching sidebar below)
                    Rectangle {
                        width: 210px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            Image {
                                source: @image-url("logo.png");
                                width: 22px;
                                height: 22px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "xsync";
                                color: root.text_main;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Drive";
                                color: root.text_muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // Vertical separator aligned with sidebar divider
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: root.border_color;
                        }
                    }

                    // Right Content HeaderBar (Aligned with main content)
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                        // Status Pill (Left-aligned above content!)
                        Rectangle {
                            height: 24px;
                            background: root.is_paused ? 
                                (root.is_dark ? #533f03 : #fef3c7) : 
                                (root.is_syncing ? (root.is_dark ? #0b3d68 : #dbeafe) : (root.is_dark ? #0f5132 : #e6f4ea));
                            border-radius: 12px;
                            vertical-stretch: 0;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.is_paused ? #f59e0b : (root.is_syncing ? #3b82f6 : #137333);
                                    vertical-stretch: 0;
                                }

                                Text {
                                    text: root.is_paused ? "Paused" : (root.is_syncing ? "Syncing..." : root.status_message);
                                    color: root.is_paused ? 
                                        (root.is_dark ? #fde68a : #92400e) : 
                                        (root.is_syncing ? (root.is_dark ? #bfdbfe : #1e40af) : (root.is_dark ? #a7f3d0 : #137333));
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Right Controls (Theme, Sync Now, Pause)
                        HorizontalLayout {
                            spacing: 8px;

                            // Theme Toggle Button with vector SVG
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: touch_theme.has-hover ? 
                                    (root.is_dark ? #3c4043 : #d8dfea) : 
                                    (root.is_dark ? #282a2c : #f1f3f4);
                                border-width: 1px;
                                border-color: root.border_color;
                                animate background { duration: 100ms; }
                                vertical-stretch: 0;

                                Image {
                                    source: root.is_dark ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.is_dark ? #fef08a : #1e293b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch_theme := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.is_dark = !root.is_dark; }
                                }
                            }

                            CompactButton {
                                text: root.is_syncing ? "Syncing" : "Sync Now";
                                primary: true;
                                is_dark: root.is_dark;
                                icon: @image-url("icons/refresh.svg");
                                has_icon: true;
                                clicked => { root.sync_now(); }
                            }

                            CompactButton {
                                text: root.is_paused ? "Resume" : "Pause";
                                is_dark: root.is_dark;
                                icon: root.is_paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                                has_icon: true;
                                clicked => { root.toggle_pause(); }
                            }
                        }
                    }
                }
            }

            // MAIN SPLIT (Sidebar + Content)
            HorizontalLayout {
                spacing: 0px;

                // COMPACT SIDEBAR (210px)
                Rectangle {
                    width: 210px;
                    background: root.bg_sidebar;

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: root.border_color;
                    }

                    VerticalLayout {
                        alignment: start;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 12px;

                        // Navigation Items Group 1
                        VerticalLayout {
                            spacing: 3px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 2px;
                                Text {
                                    text: "GOOGLE DRIVE";
                                    color: root.text_dim;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                            }

                            NavPill {
                                title: "This Computer";
                                subtitle: "Folders from PC";
                                icon: @image-url("icons/computer.svg");
                                active: root.active_tab == 0;
                                is_dark: root.is_dark;
                                clicked => { root.active_tab = 0; }
                            }

                            NavPill {
                                title: "Google Drive";
                                subtitle: "Cloud quota & info";
                                icon: @image-url("icons/cloud.svg");
                                active: root.active_tab == 1;
                                is_dark: root.is_dark;
                                clicked => { root.active_tab = 1; }
                            }

                            NavPill {
                                title: "Activity Log";
                                subtitle: "Recent sync events";
                                icon: @image-url("icons/activity.svg");
                                active: root.active_tab == 2;
                                is_dark: root.is_dark;
                                clicked => { root.active_tab = 2; }
                            }
                        }

                        // Navigation Items Group 2
                        VerticalLayout {
                            spacing: 3px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 2px;
                                Text {
                                    text: "SETTINGS";
                                    color: root.text_dim;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                            }

                            NavPill {
                                title: "Drive Diff & Merge";
                                subtitle: "Compare folders";
                                icon: @image-url("icons/diff.svg");
                                active: root.active_tab == 3;
                                is_dark: root.is_dark;
                                clicked => { root.active_tab = 3; }
                            }

                            NavPill {
                                title: "Preferences";
                                subtitle: "Theme & daemon";
                                icon: @image-url("icons/settings.svg");
                                active: root.active_tab == 4;
                                is_dark: root.is_dark;
                                clicked => { root.active_tab = 4; }
                            }
                        }

                        // Spacer keeping storage widget docked cleanly at the bottom
                        Rectangle { vertical-stretch: 1; }

                        // Compact Storage Widget
                        Rectangle {
                            background: root.bg_card;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.border_color;
                            vertical-stretch: 0;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    Text {
                                        text: "Storage";
                                        color: root.text_main;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.storage_used_str + " / " + root.storage_total_str;
                                        color: root.text_muted;
                                        font-size: 10.5px;
                                    }
                                }

                                // 4px Mini Bar
                                Rectangle {
                                    height: 4px;
                                    background: root.is_dark ? #3c4043 : #dadce0;
                                    border-radius: 2px;

                                    Rectangle {
                                        x: 0px;
                                        width: parent.width * root.storage_ratio;
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: root.is_dark ? #8ab4f8 : #0b57d0;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 5px;
                                    alignment: center;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.is_connected ? #10b981 : #ef4444;
                                    }

                                    Text {
                                        text: root.user_email;
                                        color: root.text_muted;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // CONTENT AREA (Strictly packed to top)
                Rectangle {
                    background: root.bg_window;
                    horizontal-stretch: 1;

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 18px;
                            padding-bottom: 24px;
                            spacing: 16px;

                            // ==========================================
                            // TAB 0: THIS COMPUTER (FOLDERS FROM PC)
                            // ==========================================
                            if root.active_tab == 0: VerticalLayout {
                                alignment: start;
                                spacing: 14px;

                                // Header row: Title + [+ Add folder]
                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        Text {
                                            text: "This Computer";
                                            color: root.text_main;
                                            font-size: 18px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Choose local folders to sync with Google Drive. Filtered with .gitignore automatically.";
                                            color: root.text_muted;
                                            font-size: 12px;
                                        }
                                    }

                                    CompactButton {
                                        text: "Add Folder";
                                        primary: true;
                                        is_dark: root.is_dark;
                                        icon: @image-url("icons/plus.svg");
                                        has_icon: true;
                                        clicked => { root.browse_local_folder(); }
                                    }
                                }

                                // Quick Add Folder Inputs (when a path is selected)
                                if root.new_folder_local != "": GroupSection {
                                    title: "CONFIGURE NEW FOLDER";
                                    description: "Set the local directory and destination folder in Google Drive.";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;

                                            VerticalLayout {
                                                horizontal-stretch: 2;
                                                spacing: 3px;
                                                Text { text: "Local Path:"; color: root.text_muted; font-size: 10.5px; }
                                                LineEdit {
                                                    text <=> root.new_folder_local;
                                                    placeholder-text: "Local path";
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 3px;
                                                Text { text: "Drive Folder:"; color: root.text_muted; font-size: 10.5px; }
                                                LineEdit {
                                                    text <=> root.new_folder_remote;
                                                    placeholder-text: "e.g. Documents";
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;

                                            CompactButton {
                                                text: "Cancel";
                                                is_dark: root.is_dark;
                                                clicked => {
                                                    root.new_folder_local = "";
                                                    root.new_folder_remote = "";
                                                }
                                            }

                                            CompactButton {
                                                text: "Save & Sync";
                                                primary: true;
                                                is_dark: root.is_dark;
                                                clicked => {
                                                    root.add_directory(root.new_folder_local, root.new_folder_remote);
                                                    root.new_folder_local = "";
                                                    root.new_folder_remote = "";
                                                }
                                            }
                                        }
                                    }
                                }

                                // List of Synced Folders (Placed directly below header)
                                GroupSection {
                                    title: "SYNCED DIRECTORIES (" + root.total_directories + ")";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    if root.directories.length == 0: VerticalLayout {
                                        padding: 24px;
                                        alignment: center;
                                        spacing: 6px;

                                        Image {
                                            source: @image-url("icons/folder.svg");
                                            width: 28px;
                                            height: 28px;
                                            colorize: root.text_muted;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "No Folders Synced Yet";
                                            color: root.text_main;
                                            font-size: 14px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: "Click 'Add Folder' above to link a directory.";
                                            color: root.text_muted;
                                            font-size: 11.5px;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    for dir[idx] in root.directories: ListRow {
                                        title: dir.local_path;
                                        subtitle: "Drive target: " + dir.drive_folder_name + " • .xsyncignore active";
                                        icon: @image-url("icons/folder.svg");
                                        icon_bg: root.is_dark ? #1e3a8a30 : #e1f0ff;
                                        icon_color: root.is_dark ? #93c5fd : #1d4ed8;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: idx < root.directories.length - 1;
                                        divider_color: root.border_color;

                                        SubtleButton {
                                            text: "Remove";
                                            destructive: true;
                                            is_dark: root.is_dark;
                                            icon: @image-url("icons/trash.svg");
                                            has_icon: true;
                                            clicked => { root.remove_directory(dir.local_path); }
                                        }
                                    }
                                }
                            }

                            // ==========================================
                            // TAB 1: GOOGLE DRIVE (CLOUD STORAGE)
                            // ==========================================
                            if root.active_tab == 1: VerticalLayout {
                                alignment: start;
                                spacing: 14px;

                                Text {
                                    text: "Google Drive";
                                    color: root.text_main;
                                    font-size: 18px;
                                    font-weight: 700;
                                }

                                GroupSection {
                                    title: "ACCOUNT & QUOTA";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    ListRow {
                                        title: root.user_name;
                                        subtitle: root.user_email;
                                        icon: @image-url("icons/user.svg");
                                        icon_bg: root.is_dark ? #0f513230 : #d1e7dd;
                                        icon_color: root.is_dark ? #34d399 : #0f5132;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: true;
                                        divider_color: root.border_color;

                                        if root.is_connected: Rectangle {
                                            background: root.is_dark ? #0f5132 : #d1e7dd;
                                            border-radius: 4px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                padding-top: 3px;
                                                padding-bottom: 3px;
                                                Text {
                                                    text: "Connected";
                                                    color: root.is_dark ? #a7f3d0 : #0f5132;
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                }
                                            }
                                        }

                                        if !root.is_connected: CompactButton {
                                            text: "Sign In";
                                            primary: true;
                                            is_dark: root.is_dark;
                                            icon: @image-url("icons/user.svg");
                                            has_icon: true;
                                            clicked => { root.login(); }
                                        }
                                    }

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            Text {
                                                text: "Storage Breakdown";
                                                color: root.text_main;
                                                font-size: 12px;
                                                font-weight: 600;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: root.storage_used_str + " of " + root.storage_total_str;
                                                color: root.is_dark ? #8ab4f8 : #0b57d0;
                                                font-size: 12px;
                                                font-weight: 600;
                                            }
                                        }

                                        Rectangle {
                                            height: 6px;
                                            background: root.is_dark ? #3c4043 : #dadce0;
                                            border-radius: 3px;

                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * root.storage_ratio;
                                                height: parent.height;
                                                border-radius: 3px;
                                                background: root.is_dark ? #8ab4f8 : #0b57d0;
                                            }
                                        }
                                    }
                                }

                                GroupSection {
                                    title: "OVERVIEW";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    ListRow {
                                        title: "Watched Folders";
                                        subtitle: "Directories linked on this computer";
                                        icon: @image-url("icons/folder.svg");
                                        icon_bg: root.is_dark ? #1e3a8a30 : #e1f0ff;
                                        icon_color: root.is_dark ? #93c5fd : #1d4ed8;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: true;
                                        divider_color: root.border_color;
                                        Text { text: root.total_directories; color: root.text_main; font-size: 13px; font-weight: 700; }
                                    }

                                    ListRow {
                                        title: "Total Files Tracked";
                                        subtitle: "Indexed in local SQLite cache";
                                        icon: @image-url("icons/file.svg");
                                        icon_bg: root.is_dark ? #1e293b : #e1f0ff;
                                        icon_color: root.is_dark ? #94a3b8 : #475569;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: true;
                                        divider_color: root.border_color;
                                        Text { text: root.total_files_tracked; color: root.text_main; font-size: 13px; font-weight: 700; }
                                    }

                                    ListRow {
                                        title: "Total Data Volume";
                                        subtitle: "Combined size of synchronized files";
                                        icon: @image-url("icons/storage.svg");
                                        icon_bg: root.is_dark ? #0f513230 : #d1e7dd;
                                        icon_color: root.is_dark ? #34d399 : #0f5132;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        Text { text: root.total_bytes_str; color: root.text_main; font-size: 13px; font-weight: 700; }
                                    }
                                }
                            }

                            // ==========================================
                            // TAB 2: ACTIVITY LOG
                            // ==========================================
                            if root.active_tab == 2: VerticalLayout {
                                alignment: start;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Sync Activity";
                                        color: root.text_main;
                                        font-size: 18px;
                                        font-weight: 700;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    CompactButton {
                                        text: "Refresh";
                                        icon: @image-url("icons/refresh.svg");
                                        has_icon: true;
                                        is_dark: root.is_dark;
                                        clicked => { root.refresh_state(); }
                                    }
                                }

                                GroupSection {
                                    title: "RECENT TRANSFERS";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    if root.recent_files.length == 0: VerticalLayout {
                                        padding: 24px;
                                        alignment: center;
                                        Text {
                                            text: "No recent activity recorded yet.";
                                            color: root.text_muted;
                                            font-size: 12px;
                                        }
                                    }

                                    for file[idx] in root.recent_files: ListRow {
                                        title: file.rel_path;
                                        subtitle: file.time_str + " • " + file.size_str;
                                        icon: @image-url("icons/file.svg");
                                        icon_bg: root.is_dark ? #1e293b : #e1f0ff;
                                        icon_color: root.is_dark ? #94a3b8 : #475569;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: idx < root.recent_files.length - 1;
                                        divider_color: root.border_color;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: root.is_dark ? #0f513230 : #ceead6;

                                            Image {
                                                source: @image-url("icons/check.svg");
                                                width: 10px;
                                                height: 10px;
                                                colorize: root.is_dark ? #34d399 : #137333;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // ==========================================
                            // TAB 3: DRIVE DIFF & MERGE
                            // ==========================================
                            if root.active_tab == 3: VerticalLayout {
                                alignment: start;
                                spacing: 14px;

                                Text {
                                    text: "Folder Diff & Merge";
                                    color: root.text_main;
                                    font-size: 18px;
                                    font-weight: 700;
                                }

                                GroupSection {
                                    title: "COMPARE GOOGLE DRIVE FOLDERS";
                                    description: "Compare MD5 hashes between remote folders or backup targets.";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            spacing: 10px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Source Folder (ID or 'root'):"; color: root.text_muted; font-size: 10.5px; }
                                                LineEdit {
                                                    text <=> root.diff_folder1;
                                                    placeholder-text: "root";
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: "Destination Folder (ID or name):"; color: root.text_muted; font-size: 10.5px; }
                                                LineEdit {
                                                    text <=> root.diff_folder2;
                                                    placeholder-text: "Backup";
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            CompactButton {
                                                text: "Compare Folders";
                                                primary: true;
                                                icon: @image-url("icons/diff.svg");
                                                has_icon: true;
                                                is_dark: root.is_dark;
                                                clicked => { root.run_diff(root.diff_folder1, root.diff_folder2); }
                                            }

                                            CompactButton {
                                                text: "Merge Missing Files";
                                                icon: @image-url("icons/plus.svg");
                                                has_icon: true;
                                                is_dark: root.is_dark;
                                                clicked => { root.run_merge(root.diff_folder1, root.diff_folder2); }
                                            }
                                        }

                                        Text {
                                            text: root.diff_summary;
                                            color: root.is_dark ? #8ab4f8 : #0b57d0;
                                            font-size: 11.5px;
                                            font-weight: 500;
                                        }
                                    }
                                }

                                if root.diff_items.length > 0: GroupSection {
                                    title: "DIFFERENCES (" + root.diff_items.length + ")";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    for item[idx] in root.diff_items: ListRow {
                                        title: item.path;
                                        subtitle: item.side;
                                        icon: @image-url("icons/diff.svg");
                                        icon_bg: item.side == "modified" ? 
                                            (root.is_dark ? #1e3a8a30 : #e1f0ff) : 
                                            (root.is_dark ? #0f513230 : #d1e7dd);
                                        icon_color: item.side == "modified" ? 
                                            (root.is_dark ? #93c5fd : #1d4ed8) : 
                                            (root.is_dark ? #34d399 : #0f5132);
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: idx < root.diff_items.length - 1;
                                        divider_color: root.border_color;
                                    }
                                }
                            }

                            // ==========================================
                            // TAB 4: PREFERENCES & SETTINGS
                            // ==========================================
                            if root.active_tab == 4: VerticalLayout {
                                alignment: start;
                                spacing: 14px;

                                Text {
                                    text: "Preferences";
                                    color: root.text_main;
                                    font-size: 18px;
                                    font-weight: 700;
                                }

                                // Appearance
                                GroupSection {
                                    title: "APPEARANCE";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    ListRow {
                                        title: "Theme Mode";
                                        subtitle: root.is_dark ? "Dark Mode (Material You Dark)" : "Light Mode (Google White)";
                                        icon: root.is_dark ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
                                        icon_bg: root.is_dark ? #1e293b : #fef9c3;
                                        icon_color: root.is_dark ? #fde047 : #ca8a04;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            CompactButton {
                                                text: "Light";
                                                primary: !root.is_dark;
                                                is_dark: root.is_dark;
                                                clicked => { root.is_dark = false; }
                                            }
                                            CompactButton {
                                                text: "Dark";
                                                primary: root.is_dark;
                                                is_dark: root.is_dark;
                                                clicked => { root.is_dark = true; }
                                            }
                                        }
                                    }
                                }

                                // Daemon
                                GroupSection {
                                    title: "BACKGROUND DAEMON (SYSTEMD)";
                                    description: "Manage ~/.config/systemd/user/xsync.service";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    ListRow {
                                        title: "Service Controls";
                                        subtitle: "Start, stop, or restart the sync watcher";
                                        icon: @image-url("icons/power.svg");
                                        icon_bg: root.is_dark ? #3b2a1a : #ffedd5;
                                        icon_color: root.is_dark ? #fb923c : #ea580c;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: true;
                                        divider_color: root.border_color;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            CompactButton { text: "Start"; is_dark: root.is_dark; clicked => { root.systemd_action("start"); } }
                                            CompactButton { text: "Stop"; is_dark: root.is_dark; clicked => { root.systemd_action("stop"); } }
                                            CompactButton { text: "Restart"; is_dark: root.is_dark; clicked => { root.systemd_action("restart"); } }
                                        }
                                    }

                                    ListRow {
                                        title: "Enable on Boot";
                                        subtitle: "Start daemon upon user login";
                                        icon: @image-url("icons/rocket.svg");
                                        icon_bg: root.is_dark ? #1e3a8a30 : #e1f0ff;
                                        icon_color: root.is_dark ? #93c5fd : #1d4ed8;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;

                                        CompactButton {
                                            text: "Enable";
                                            primary: true;
                                            is_dark: root.is_dark;
                                            clicked => { root.systemd_action("install"); }
                                        }
                                    }
                                }

                                // Account
                                GroupSection {
                                    title: "ACCOUNT";
                                    card_bg: root.bg_card;
                                    card_border: root.border_color;
                                    title_color: root.text_main;
                                    desc_color: root.text_muted;

                                    ListRow {
                                        title: root.user_name;
                                        subtitle: root.user_email;
                                        icon: @image-url("icons/user.svg");
                                        icon_bg: root.is_dark ? #0f513230 : #d1e7dd;
                                        icon_color: root.is_dark ? #34d399 : #0f5132;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;
                                        show_divider: true;
                                        divider_color: root.border_color;

                                        if root.is_connected: SubtleButton {
                                            text: "Sign Out";
                                            destructive: true;
                                            is_dark: root.is_dark;
                                            clicked => { root.logout(); }
                                        }

                                        if !root.is_connected: CompactButton {
                                            text: "Sign In";
                                            primary: true;
                                            is_dark: root.is_dark;
                                            icon: @image-url("icons/user.svg");
                                            has_icon: true;
                                            clicked => { root.login(); }
                                        }
                                    }

                                    ListRow {
                                        title: "Selective Ignore Engine";
                                        subtitle: "node_modules, .venv, target/, and .git ignored";
                                        icon: @image-url("icons/shield.svg");
                                        icon_bg: root.is_dark ? #0f513230 : #d1e7dd;
                                        icon_color: root.is_dark ? #34d399 : #0f5132;
                                        text_color: root.text_main;
                                        subtitle_color: root.text_muted;

                                        Rectangle {
                                            background: root.is_dark ? #0f513230 : #ceead6;
                                            border-radius: 4px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                padding-top: 2px;
                                                padding-bottom: 2px;
                                                Text {
                                                    text: "Active";
                                                    color: root.is_dark ? #34d399 : #137333;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
