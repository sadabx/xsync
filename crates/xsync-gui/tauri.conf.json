{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xsync",
  "version": "0.2.0",
  "identifier": "com.sadab.xsync",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "xsync - Google Drive Desktop",
        "width": 1080,
        "height": 700,
        "minWidth": 920,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
